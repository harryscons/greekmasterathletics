{
  "rules": {
    "records":      { ".read": "true", ".write": "auth != null && root.child('roles').child(auth.uid).val() == 'Supervisor'" },
    "athletes":     { ".read": "true", ".write": "auth != null && root.child('roles').child(auth.uid).val() == 'Supervisor'" },
    "events":       { ".read": "true", ".write": "auth != null && root.child('roles').child(auth.uid).val() == 'Supervisor'" },
    "countries":    { ".read": "true", ".write": "auth != null && root.child('roles').child(auth.uid).val() == 'Supervisor'" },
    "history":      { ".read": "true", ".write": "auth != null && root.child('roles').child(auth.uid).val() == 'Supervisor'" },
    "users":        { ".read": "true", ".write": "auth != null && root.child('roles').child(auth.uid).val() == 'Supervisor'" },
    "stats":        { ".read": "true", ".write": "auth != null && root.child('roles').child(auth.uid).val() == 'Supervisor'" },
    "tombstones":   { ".read": "true", ".write": "auth != null && (root.child('roles').child(auth.uid).val() == 'Admin' || root.child('roles').child(auth.uid).val() == 'Supervisor')" },
    
    "pendingrecs": { 
      ".read": "true", 
      ".write": "auth != null && (root.child('roles').child(auth.uid).val() == 'Admin' || root.child('roles').child(auth.uid).val() == 'Supervisor')"
    },

    "activeSessions": { ".read": "true", ".write": "auth != null" },

    "roles": {
      "$uid": {
        ".read": "true",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "usersettings": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}
