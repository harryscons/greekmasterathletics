{
  "rules": {
    // PUBLIC READ: Allow guests to view the records without sync errors.
    "records": { ".read": "true", ".write": "auth != null && (auth.token.email.toLowerCase() == 'cha.kons@gmail.com' || auth.token.email.toLowerCase() == 'admin@greekmasterathletics.com' || auth.token.email.toLowerCase() == 'support@greekmasterathletics.com')" },
    "athletes": { ".read": "true", ".write": "auth != null && (auth.token.email.toLowerCase() == 'cha.kons@gmail.com' || auth.token.email.toLowerCase() == 'admin@greekmasterathletics.com' || auth.token.email.toLowerCase() == 'support@greekmasterathletics.com')" },
    "events": { ".read": "true", ".write": "auth != null && (auth.token.email.toLowerCase() == 'cha.kons@gmail.com' || auth.token.email.toLowerCase() == 'admin@greekmasterathletics.com' || auth.token.email.toLowerCase() == 'support@greekmasterathletics.com')" },
    "countries": { ".read": "true", ".write": "auth != null && (auth.token.email.toLowerCase() == 'cha.kons@gmail.com' || auth.token.email.toLowerCase() == 'admin@greekmasterathletics.com' || auth.token.email.toLowerCase() == 'support@greekmasterathletics.com')" },
    "history": { ".read": "true", ".write": "auth != null && (auth.token.email.toLowerCase() == 'cha.kons@gmail.com' || auth.token.email.toLowerCase() == 'admin@greekmasterathletics.com' || auth.token.email.toLowerCase() == 'support@greekmasterathletics.com')" },
    "users": { ".read": "true", ".write": "auth != null && (auth.token.email.toLowerCase() == 'cha.kons@gmail.com' || auth.token.email.toLowerCase() == 'admin@greekmasterathletics.com' || auth.token.email.toLowerCase() == 'support@greekmasterathletics.com')" },
    
    // PENDING RECORDS: Allow any authenticated user (Admins/Supervisors) to propose changes.
    // They are staged here and must be approved before moving to masters.
    "pendingrecs": { ".read": "true", ".write": "auth != null" },
    "tombstones": { ".read": "true", ".write": "auth != null" },

    "usersettings": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "activeSessions": { ".read": "true", ".write": "auth != null" }
  }
}
